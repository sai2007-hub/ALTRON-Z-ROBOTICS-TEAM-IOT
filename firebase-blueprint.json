{
  "entities": {
    "Registration": {
      "title": "Registration",
      "description": "Student registration for a competition event or workshop.",
      "type": "object",
      "properties": {
        "studentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Full name of the student"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Contact email of the student"
        },
        "phone": {
          "type": "string",
          "maxLength": 25,
          "description": "Contact phone number"
        },
        "schoolOrCollege": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150,
          "description": "Name of school, college, or university"
        },
        "departmentOrClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Class, department, or academic year"
        },
        "targetType": {
          "type": "string",
          "enum": ["event", "workshop"],
          "description": "Type of program registered for"
        },
        "targetId": {
          "type": "string",
          "maxLength": 64,
          "description": "Identifier of the target event or workshop"
        },
        "targetTitle": {
          "type": "string",
          "maxLength": 150,
          "description": "Title of the target event or workshop"
        },
        "teamName": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional team name for team events"
        },
        "teamSize": {
          "type": "number",
          "description": "Number of members in the team"
        },
        "teammateDetails": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional names and details of teammates"
        },
        "experienceLevel": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"],
          "description": "Experience level of the participant"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "pending", "waitlist", "archived"],
          "description": "Verification status of the registration"
        },
        "attendanceRecorded": {
          "type": "boolean",
          "description": "Whether participant attendance has been marked"
        },
        "attended": {
          "type": "boolean",
          "description": "Whether the participant attended the event"
        },
        "attendance": {
          "type": "string",
          "enum": ["present", "absent", "excused", "unmarked"],
          "description": "Specific attendance status code"
        },
        "certificateIssued": {
          "type": "boolean",
          "description": "Whether a completion or merit certificate was issued"
        },
        "certificateId": {
          "type": "string",
          "maxLength": 64,
          "description": "Unique verified certificate credential ID"
        },
        "archivedAt": {
          "type": "string",
          "description": "Timestamp when registration was soft-deleted or archived"
        },
        "archivedBy": {
          "type": "string",
          "description": "Admin email who performed the archive"
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp when the registration was created"
        }
      },
      "required": [
        "studentName",
        "email",
        "phone",
        "schoolOrCollege",
        "departmentOrClass",
        "targetType",
        "targetId",
        "targetTitle",
        "status",
        "createdAt"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator profile",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "superadmin"],
          "description": "Administrative role level"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "role"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Photo Gallery image archive record",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "eventOrWorkshop": { "type": "string" },
        "year": { "type": "number" },
        "category": { "type": "string" },
        "caption": { "type": "string" },
        "imageUrl": { "type": "string" },
        "storagePath": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "published"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Robotics team engineer profile",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "subsystem": { "type": "string" },
        "bio": { "type": "string" },
        "skills": { "type": "array" },
        "imageUrl": { "type": "string" },
        "storagePath": { "type": "string" },
        "isLead": { "type": "boolean" },
        "published": { "type": "boolean" }
      },
      "required": ["name", "role", "published"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "Competition honor or award trophy",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "eventName": { "type": "string" },
        "year": { "type": "number" },
        "rankOrAward": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "published": { "type": "boolean" }
      },
      "required": ["title", "eventName", "year", "published"]
    },
    "Project": {
      "title": "Project",
      "description": "R&D robot or embedded machine",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "technologies": { "type": "array" },
        "status": { "type": "string" },
        "teamLead": { "type": "string" },
        "imageUrl": { "type": "string" },
        "published": { "type": "boolean" }
      },
      "required": ["title", "category", "published"]
    },
    "Event": {
      "title": "Event",
      "description": "Robotics tournament competition",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "venue": { "type": "string" },
        "published": { "type": "boolean" }
      },
      "required": ["title", "slug", "published"]
    },
    "Workshop": {
      "title": "Workshop",
      "description": "Educational robotics & IoT workshop",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "track": { "type": "string" },
        "targetAudience": { "type": "string" },
        "published": { "type": "boolean" }
      },
      "required": ["title", "slug", "published"]
    },
    "HomepageStat": {
      "title": "HomepageStat",
      "description": "Configurable metric or highlight item displayed on the homepage",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value": { "type": "string", "minLength": 1, "maxLength": 50 },
        "description": { "type": "string", "maxLength": 250 },
        "order": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "value"]
    },
    "BotDocument": {
      "title": "BotDocument",
      "description": "PDF documents, technical specifications, and blueprints for robots or competitions",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "pdfUrl": { "type": "string" },
        "publicId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "botOrCompetition": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "published": { "type": "boolean" },
        "uploadedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "pdfUrl", "status"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Dynamic configurations for Footer, About section, and Contact page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/registrations/{registrationId}": {
      "schema": {
        "$ref": "#/entities/Registration"
      },
      "description": "Collection of student registrations submitted for events and workshops"
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Collection of designated administrator accounts"
    },
    "/gallery/{galleryId}": {
      "schema": {
        "$ref": "#/entities/GalleryItem"
      },
      "description": "Photo Gallery image records and storage references"
    },
    "/teamMembers/{memberId}": {
      "schema": {
        "$ref": "#/entities/TeamMember"
      },
      "description": "Team member profiles and leadership hierarchy"
    },
    "/achievements/{achievementId}": {
      "schema": {
        "$ref": "#/entities/Achievement"
      },
      "description": "Tournament awards and competition wins"
    },
    "/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "R&D projects and prototype hardware"
    },
    "/events/{eventId}": {
      "schema": {
        "$ref": "#/entities/Event"
      },
      "description": "Tournament and competition event details"
    },
    "/workshops/{workshopId}": {
      "schema": {
        "$ref": "#/entities/Workshop"
      },
      "description": "Institutional robotics and IoT workshop tracks"
    },
    "/homepageStats/{statId}": {
      "schema": {
        "$ref": "#/entities/HomepageStat"
      },
      "description": "Homepage statistics and performance metric cards displayed to visitors"
    },
    "/botDocuments/{docId}": {
      "schema": {
        "$ref": "#/entities/BotDocument"
      },
      "description": "Uploaded PDF documents, CAD schematics, and rule compliance specifications"
    },
    "/siteContent/{contentId}": {
      "schema": {
        "$ref": "#/entities/SiteContent"
      },
      "description": "Dynamic configurations for Footer, About section, and Contact page"
    }
  }
}
